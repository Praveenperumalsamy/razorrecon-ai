# ============================================================================
# RazorRecon AI — Environment Configuration
# Copy to .env for local dev. In production, inject these via your secrets
# manager (AWS Secrets Manager, GCP Secret Manager, HashiCorp Vault, K8s
# Secrets) — never commit a real .env file. See PRODUCTION.md.
# ============================================================================

# --- Environment ---
APP_ENV=development          # development | staging | production | test
DEBUG=true                   # MUST be false in production (enforced at startup)

# --- Database ---
# Production: PostgreSQL only (SQLite is rejected at startup when APP_ENV=production)
DATABASE_URL=postgresql://razorrecon:razorrecon123@localhost:5432/razorrecon
USE_SQLITE=false             # true only for local dev/tests

# --- Auth / JWT ---
# Generate with: openssl rand -hex 32
# MUST be >= 32 random chars in production — app refuses to start otherwise.
SECRET_KEY=*****
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of exact origins. Never "*" in production.
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# --- Google Gemini (AI exception-reasoning) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Razorpay live integration ---
# From Razorpay Dashboard -> Settings -> API Keys / Webhooks.
# Leave blank to run in CSV-upload-only mode (no live API calls attempted).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Reconciliation thresholds ---
AUTO_RECONCILE_THRESHOLD=0.90
AI_REVIEW_THRESHOLD=0.75
DATE_TOLERANCE_DAYS=3

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json              # json in prod, "console" for readable local dev logs
SENTRY_DSN=                  # optional — leave blank to disable

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25

# --- docker-compose.prod.yml only ---
POSTGRES_DB=razorrecon
POSTGRES_USER=razorrecon
POSTGRES_PASSWORD=
